{
    "name": "izy/ecobank-payout",
    "description": "Ecobank Local Bank Payment: signatures, payloads and transport, framework-free.",
    "type": "library",
    "keywords": [
        "ecobank",
        "payment",
        "payout",
        "signature",
        "sha-512",
        "africa"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Izy\\EcobankPayout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Izy\\EcobankPayout\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
